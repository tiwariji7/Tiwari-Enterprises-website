---
import SiteHeader from '../components/shell/SiteHeader.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
import { SITE_CONFIG, generateLocalBusinessSchema, generateBreadcrumbSchema, type SEOProps } from '../utils/seo';
import '../styles/global.css';

interface Props {
  seo?: SEOProps;
  breadcrumbs?: { name: string; url: string }[];
  currentPath?: string;
}

const { seo = {}, breadcrumbs, currentPath = '/' } = Astro.props;

const pageTitle = seo.title
  ? (seo.title.includes(SITE_CONFIG.name) ? seo.title : `${seo.title} | ${SITE_CONFIG.name}`)
  : `${SITE_CONFIG.name} — ${SITE_CONFIG.positioning}`;

const pageDescription = seo.description || SITE_CONFIG.defaultDescription;
const ogTitle = seo.ogTitle || pageTitle;
const ogDescription = seo.ogDescription || pageDescription;
const canonicalUrl = seo.canonical || `${SITE_CONFIG.domain}${currentPath}`;
const ogImage = seo.image || `${SITE_CONFIG.domain}/images/brand/og-image.jpg`;
const ogType = seo.type || 'website';

const businessSchema = generateLocalBusinessSchema();
const breadcrumbSchema = breadcrumbs ? generateBreadcrumbSchema(breadcrumbs) : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.webp" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts Preconnect & Styles -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,600;0,700;1,600&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />

    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Preload Critical LCP Hero Image on Homepage for Near Instantaneous Rendering -->
    {currentPath === '/' && (
      <link rel="preload" as="image" href="/images/hero/hero-sliding.webp" type="image/webp" fetchpriority="high" />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={ogTitle} />
    <meta property="twitter:description" content={ogDescription} />
    <meta property="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
  </head>
  <body class="bg-paper text-ink antialiased min-h-screen flex flex-col selection:bg-gold selection:text-white">
    <SiteHeader currentPath={currentPath} />
    
    <main class={`flex-grow ${currentPath === '/' ? '' : 'pt-20'}`} id="main-content">
      <slot />
    </main>

    <SiteFooter />

    <!-- Lenis Smooth Scroll Initialization -->
    <script>
      import Lenis from 'lenis';

      // Check user reduced motion preference
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 0.9,
          touchMultiplier: 1.5,
        });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>

