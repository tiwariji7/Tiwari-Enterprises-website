---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/home/Hero.astro';
import BrandStatement from '../components/home/BrandStatement.astro';
import CoreDisciplines from '../components/home/CoreDisciplines.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import CraftStatement from '../components/home/CraftStatement.astro';
import ApproachPreview from '../components/home/ApproachPreview.astro';
import TrustSection from '../components/home/TrustSection.astro';
import ProjectCTA from '../components/home/ProjectCTA.astro';

const seo = {
  title: 'Aluminium & Glass Solutions in Pune | Tiwari Enterprises',
  description: 'Explore premium aluminium sliding systems, glass partitions, glass railings and architectural glazing solutions in Pune by Tiwari Enterprises.',
  ogTitle: 'Tiwari Enterprises | Aluminium & Glass Solutions',
  ogDescription: 'Premium architectural aluminium and glass solutions for modern spaces in Pune.',
  image: 'https://tiwarienterprises.in/images/brand/og-image.jpg',
};
---

<SiteLayout seo={seo} currentPath="/">
  <Hero />
  <BrandStatement />
  <CoreDisciplines />
  <SelectedWork />
  <CraftStatement />
  <ApproachPreview />
  <TrustSection />
  <ProjectCTA />
</SiteLayout>
