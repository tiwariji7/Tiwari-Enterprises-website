---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import { SOLUTIONS } from '../../data/solutions';

const sol = SOLUTIONS['ceilings'];

const seo = {
  title: 'POP & Architectural False Ceilings in Pune',
  description: 'Precision POP false ceilings, perimeter curtain pockets, and acoustic bulkheads tailored for architectural spaces in Pune by Tiwari Enterprises.',
};

const breadcrumbs = [
  { name: 'Solutions', url: '/solutions' },
  { name: 'POP & False Ceilings', url: '/solutions/ceilings' },
];
---

<SiteLayout seo={seo} breadcrumbs={breadcrumbs} currentPath="/solutions/ceilings">
  <article class="bg-paper pb-24">
    <div class="relative py-16 sm:py-24 bg-surface-subtle border-b border-borderMuted overflow-hidden">
      <div class="max-w-site mx-auto px-5 sm:px-8 relative z-10">
        <Breadcrumbs items={breadcrumbs} className="mb-6" />
        <div class="max-w-3xl">
          <span class="text-xs uppercase font-mono tracking-wider text-ink-muted font-bold block mb-3">
            SUPPORTING ARCHITECTURAL SERVICE · SUB-URL: /solutions/ceilings
          </span>
          <h1 class="font-display text-4xl sm:text-6xl uppercase tracking-tight font-bold text-ink leading-[1.02]">
            {sol.heroHeadline}
          </h1>
          <p class="font-body text-base sm:text-lg text-ink-muted mt-4 leading-relaxed font-normal">
            {sol.heroDescription}
          </p>
          <div class="pt-6">
            <Button href="/start-a-project?service=Ceilings" variant="primary" size="md">
              Inquire About False Ceilings
            </Button>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-site mx-auto px-5 sm:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        {sol.applications.map((app) => (
          <div class="p-8 bg-surface border border-borderMuted shadow-xs">
            <h3 class="font-display text-2xl uppercase font-bold text-ink mb-3">{app.title}</h3>
            <p class="font-body text-sm text-ink-muted leading-relaxed mb-4">{app.description}</p>
            <div class="text-xs text-ink-muted space-y-2 pt-4 border-t border-borderMuted">
              <p><strong class="text-ink">Details:</strong> {app.configurations.join(', ')}</p>
              <p><strong class="text-ink">Finishing:</strong> {app.finishes.join(', ')}</p>
              <p><strong class="text-ink">Grid:</strong> {app.hardwareNotes}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </article>
</SiteLayout>
