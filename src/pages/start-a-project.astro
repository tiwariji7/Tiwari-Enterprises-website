---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionIntro from '../components/ui/SectionIntro.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ProjectEnquiryForm from '../components/forms/ProjectEnquiryForm.astro';
import { SITE_CONFIG } from '../utils/seo';

const seo = {
  title: 'Start a Project — Architectural Quotation & Enquiry in Pune',
  description: 'Discuss your architectural aluminium, glass, sliding systems, or railing project with Tiwari Enterprises. Request a site assessment and quotation in Pune.',
};

const breadcrumbs = [{ name: 'Start a Project', url: '/start-a-project' }];
---

<SiteLayout seo={seo} breadcrumbs={breadcrumbs} currentPath="/start-a-project">
  <div class="py-12 sm:py-20 bg-paper">
    <div class="max-w-site mx-auto px-5 sm:px-8">
      <Breadcrumbs items={breadcrumbs} className="mb-8" />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left: Briefing & Reassurance (5 cols) -->
        <div class="lg:col-span-5 flex flex-col gap-8">
          <SectionIntro
            eyebrow="PROJECT ENQUIRY"
            heading="Let's Discuss Your Space"
            lead="Share details about your architectural requirements, opening dimensions, or location in Pune. We will review your brief and contact you within 24 business hours."
          />

          <div class="p-6 bg-surface border border-borderMuted space-y-4 shadow-xs">
            <span class="font-display text-sm uppercase tracking-architectural text-gold font-bold block">
              Helpful Details to Share
            </span>
            <ul class="space-y-2.5 font-body text-xs text-ink-muted">
              <li class="flex items-start gap-2">
                <span class="text-gold font-bold">▪</span>
                <span>Type of property (e.g. villa, apartment, commercial office, showroom).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gold font-bold">▪</span>
                <span>Approximate opening dimensions or number of doors/windows.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gold font-bold">▪</span>
                <span>Performance priorities (e.g. acoustic soundproofing, slimline look, weather sealing).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gold font-bold">▪</span>
                <span>Site readiness and expected completion timeline in Pune.</span>
              </li>
            </ul>
          </div>

          <div class="p-6 bg-surface border border-borderMuted shadow-2xs flex flex-col gap-3">
            <span class="font-mono text-xs text-ink-muted uppercase tracking-wider block font-semibold">
              Direct Contact &amp; Consultations
            </span>
            <p class="font-body text-sm text-ink font-semibold">
              Prefer an immediate conversation? Reach us directly:
            </p>
            <div class="flex flex-col gap-2 pt-1 font-mono text-xs">
              <a
                href={`tel:${SITE_CONFIG.phone.replace(/\\s+/g, '')}`}
                class="inline-flex items-center gap-2 font-bold text-ink hover:text-gold transition-colors py-1"
              >
                <span class="w-2 h-2 rounded-full bg-gold"></span>
                <span>📞 Call: {SITE_CONFIG.phone}</span>
              </a>
              <a
                href={`https://wa.me/${SITE_CONFIG.whatsapp}?text=Hello%20Tiwari%20Enterprises,%20I%20would%20like%20to%20discuss%20an%20architectural%20project.`}
                class="inline-flex items-center gap-2 font-bold text-[#25D366] hover:text-[#20bd5a] transition-colors py-1"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
                <span>💬 WhatsApp: {SITE_CONFIG.whatsappFormatted} →</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Interactive Validated Form (7 cols) -->
        <div class="lg:col-span-7">
          <ProjectEnquiryForm />
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
