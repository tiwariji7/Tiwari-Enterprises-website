---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SectionIntro from '../../components/ui/SectionIntro.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { PROJECTS } from '../../data/projects';

const seo = {
  title: 'Selected Architectural Projects & Case Studies in Pune',
  description: 'Explore completed aluminium sliding systems, architectural glass partitions, and structural facades crafted by Tiwari Enterprises across Pune.',
};

const breadcrumbs = [{ name: 'Work', url: '/work' }];
const filterCategories = [
  { label: 'All Projects', slug: 'all', url: '/work' },
  { label: 'Residential', slug: 'residential', url: '/work/category/residential' },
  { label: 'Commercial', slug: 'commercial', url: '/work/category/commercial' },
  { label: 'Aluminium Works', slug: 'aluminium', url: '/work/category/aluminium' },
  { label: 'Glass Works', slug: 'glass', url: '/work/category/glass' },
];
---

<SiteLayout seo={seo} breadcrumbs={breadcrumbs} currentPath="/work">
  <div class="py-12 sm:py-20 bg-paper">
    <div class="max-w-site mx-auto px-5 sm:px-8">
      <Breadcrumbs items={breadcrumbs} className="mb-8" />

      <div class="max-w-3xl mb-12 sm:mb-16">
        <SectionIntro
          eyebrow="SELECTED PORTFOLIO"
          heading="Architectural Work Across Pune"
          lead="Every project represents a bespoke collaboration between architectural vision, structural engineering, and precision fabrication."
        />
      </div>

      <!-- Category Filter Tabs with Distinct Sub-URLs -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-3 pb-8 mb-10 border-b border-borderMuted" id="filter-tabs">
        {filterCategories.map((cat, idx) => (
          <a
            href={cat.url}
            data-filter={cat.slug}
            class={`filter-btn px-4 py-2 text-xs uppercase tracking-wider font-body transition-all duration-200 border cursor-pointer ${
              idx === 0
                ? 'bg-ink text-white border-ink font-bold'
                : 'bg-surface text-ink border-borderMuted hover:border-gold hover:text-gold font-medium'
            }`}
          >
            {cat.label}
          </a>
        ))}
      </div>

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="projects-grid">
        {PROJECTS.map((project) => (
          <article
            class="project-card group bg-surface border border-borderMuted overflow-hidden flex flex-col justify-between hover:border-gold transition-all duration-300 shadow-xs"
            data-category={project.category.toLowerCase()}
            data-discipline={project.discipline.toLowerCase()}
          >
            <a href={`/work/${project.slug}`} class="block overflow-hidden relative aspect-[4/3] bg-surface-muted">
              <img
                src={project.featuredImage}
                alt={project.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute top-4 left-4 flex gap-2">
                <a href={`/work/category/${project.category.toLowerCase()}`} class="px-2.5 py-1 bg-white border border-borderMuted text-ink text-[10px] uppercase font-mono font-bold tracking-wider hover:text-gold shadow-xs">
                  {project.category}
                </a>
                <a href={`/work/category/${project.discipline.toLowerCase()}`} class="px-2.5 py-1 bg-gold text-white text-[10px] uppercase font-bold tracking-wider hover:bg-gold-dark shadow-xs">
                  {project.discipline}
                </a>
              </div>
              <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-xs text-ink bg-white px-3 py-1.5 border border-borderMuted font-mono shadow-xs">
                <span class="font-semibold">{project.location}</span>
                <span>{project.year}</span>
              </div>
            </a>

            <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow gap-4">
              <div>
                <h2 class="font-display text-2xl uppercase tracking-tight font-bold text-ink group-hover:text-gold transition-colors">
                  <a href={`/work/${project.slug}`}>
                    {project.title}
                  </a>
                </h2>
                <p class="font-body text-xs sm:text-sm text-ink-muted mt-2 line-clamp-3 leading-relaxed">
                  {project.summary}
                </p>
              </div>

              <div class="pt-4 border-t border-borderMuted flex items-center justify-between text-xs">
                <span class="text-ink-muted uppercase tracking-wider font-mono">
                  {project.materials[0].split(' ')[0]} Alloy
                </span>
                <a href={`/work/${project.slug}`} class="text-gold font-bold uppercase tracking-wider hover:underline inline-flex items-center gap-1">
                  <span>View Case Study Sub-URL</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</SiteLayout>
