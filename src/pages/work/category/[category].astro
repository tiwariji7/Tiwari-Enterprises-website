---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SectionIntro from '../../../components/ui/SectionIntro.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import { PROJECTS } from '../../../data/projects';

export function getStaticPaths() {
  const categories = ['residential', 'commercial', 'aluminium', 'glass'];
  return categories.map((cat) => ({
    params: { category: cat },
  }));
}

const { category } = Astro.params;

const categoryTitleMap: Record<string, string> = {
  residential: 'Residential Architectural Projects',
  commercial: 'Commercial Architectural Projects',
  aluminium: 'Aluminium Architectural Systems',
  glass: 'Architectural Glass Installations',
};

const title = categoryTitleMap[category] || `${category} Projects`;

const filteredProjects = PROJECTS.filter((p) => {
  return (
    p.category.toLowerCase() === category.toLowerCase() ||
    p.discipline.toLowerCase() === category.toLowerCase()
  );
});

const filterCategories = [
  { label: 'All Projects', slug: 'all', url: '/work' },
  { label: 'Residential', slug: 'residential', url: '/work/category/residential' },
  { label: 'Commercial', slug: 'commercial', url: '/work/category/commercial' },
  { label: 'Aluminium Works', slug: 'aluminium', url: '/work/category/aluminium' },
  { label: 'Glass Works', slug: 'glass', url: '/work/category/glass' },
];

const seo = {
  title: `${title} in Pune — Case Studies`,
  description: `Explore completed ${title.toLowerCase()} in Pune by Tiwari Enterprises. Case studies, materials, and verified specifications.`,
};

const breadcrumbs = [
  { name: 'Work', url: '/work' },
  { name: title, url: `/work/category/${category}` },
];
---

<SiteLayout seo={seo} breadcrumbs={breadcrumbs} currentPath={`/work/category/${category}`}>
  <div class="py-12 sm:py-20 bg-paper">
    <div class="max-w-site mx-auto px-5 sm:px-8">
      <Breadcrumbs items={breadcrumbs} className="mb-8" />

      <div class="max-w-3xl mb-12 sm:mb-16">
        <SectionIntro
          eyebrow="PROJECT CATEGORY"
          heading={title}
          lead={`Showing ${filteredProjects.length} verified projects engineered across Pune in this specialization.`}
        />
      </div>

      <!-- Category Filter Tabs with Distinct Sub-URLs -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-3 pb-8 mb-10 border-b border-borderMuted">
        {filterCategories.map((cat) => (
          <a
            href={cat.url}
            class={`px-4 py-2 text-xs uppercase tracking-wider font-body transition-all duration-200 border cursor-pointer ${
              cat.slug === category
                ? 'bg-ink text-white border-ink font-bold'
                : 'bg-surface text-ink border-borderMuted hover:border-gold hover:text-gold font-medium'
            }`}
          >
            {cat.label}
          </a>
        ))}
      </div>

      <!-- Filtered Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {filteredProjects.map((project) => (
          <article class="group bg-surface border border-borderMuted overflow-hidden flex flex-col justify-between hover:border-gold transition-all duration-300 shadow-xs">
            <a href={`/work/${project.slug}`} class="block overflow-hidden relative aspect-[4/3] bg-surface-muted">
              <img
                src={project.featuredImage}
                alt={project.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute top-4 left-4 flex gap-2">
                <span class="px-2.5 py-1 bg-white border border-borderMuted text-ink text-[10px] uppercase font-mono font-bold tracking-wider shadow-xs">
                  {project.category}
                </span>
                <span class="px-2.5 py-1 bg-gold text-white text-[10px] uppercase font-bold tracking-wider">
                  {project.discipline}
                </span>
              </div>
              <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-xs text-ink bg-white px-3 py-1.5 border border-borderMuted font-mono shadow-xs">
                <span class="font-semibold">{project.location}</span>
                <span>{project.year}</span>
              </div>
            </a>

            <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow gap-4">
              <div>
                <h2 class="font-display text-2xl uppercase tracking-tight font-bold text-ink group-hover:text-gold transition-colors">
                  <a href={`/work/${project.slug}`}>
                    {project.title}
                  </a>
                </h2>
                <p class="font-body text-xs sm:text-sm text-ink-muted mt-2 line-clamp-3 leading-relaxed">
                  {project.summary}
                </p>
              </div>

              <div class="pt-4 border-t border-borderMuted flex items-center justify-between text-xs">
                <span class="text-ink-muted uppercase tracking-wider font-mono truncate max-w-[65%]">
                  {project.materials[0]}
                </span>
                <a href={`/work/${project.slug}`} class="text-gold font-bold uppercase tracking-wider hover:underline inline-flex items-center gap-1 shrink-0">
                  <span>View Project Case Study</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</SiteLayout>

