---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  lead?: string;
  align?: 'left' | 'center';
  className?: string;
}

const {
  eyebrow,
  heading,
  lead,
  align = 'left',
  className = '',
} = Astro.props;

const alignmentClasses = align === 'center' ? 'text-center mx-auto items-center' : 'text-left items-start';
---

<div class={`flex flex-col gap-3 max-w-3xl ${alignmentClasses} ${className}`}>
  {eyebrow && <Eyebrow text={eyebrow} />}
  <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl uppercase tracking-tight font-bold leading-[1.05] text-ink">
    {heading}
  </h2>
  {lead && (
    <p class="font-body text-base sm:text-lg leading-relaxed max-w-2xl mt-1 text-ink-muted">
      {lead}
    </p>
  )}
</div>
