---
import Button from '../ui/Button.astro';
import { SITE_CONFIG } from '../../utils/seo';

interface Props {
  preselectedService?: string;
}

const { preselectedService = '' } = Astro.props;

const services = [
  'Aluminium Works (Windows, Sliders, Facades)',
  'Glass Works (Partitions, Railings, Enclosures)',
  'Secondary Steel Works',
  'POP & False Ceiling',
  'Interior Architectural Solutions',
  'Not sure / Need guidance',
];

const puneLocations = [
  'Baner / Balewadi',
  'Wakad / Hinjewadi',
  'Kothrud / Bavdhan',
  'Koregaon Park / Kalyani Nagar',
  'Prabhat Road / Shivajinagar',
  'Hadapsar / Magarpatta',
  'Aundh / Model Colony',
  'Pimpri-Chinchwad (PCMC)',
  'Other Pune Location',
];
---

<div class="bg-surface border border-borderMuted p-6 sm:p-10 relative shadow-sm">
  <form id="project-enquiry-form" class="flex flex-col gap-6" novalidate>
    <!-- Status Messages -->
    <div id="form-error-banner" class="hidden p-4 bg-red-50 border border-red-300 text-red-800 text-xs sm:text-sm font-body"></div>
    <div id="form-success-banner" class="hidden p-4 bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs sm:text-sm font-body">
      Thank you! Your enquiry has been received. Redirecting to confirmation page...
    </div>

    <!-- Row 1: Name and Phone -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="flex flex-col gap-2">
        <label for="fullName" class="text-xs uppercase tracking-wider font-body text-ink font-semibold">
          Full Name <span class="text-gold">*</span>
        </label>
        <input
          type="text"
          id="fullName"
          name="fullName"
          required
          placeholder="e.g. Rahul Sharma"
          class="bg-paper border border-borderMuted px-4 py-3 text-ink font-body text-sm placeholder:text-ink-muted/50 focus:border-gold focus:outline-none transition-colors"
        />
        <span class="error-msg text-[11px] text-red-600 font-body hidden" id="err-fullName"></span>
      </div>

      <div class="flex flex-col gap-2">
        <label for="phone" class="text-xs uppercase tracking-wider font-body text-ink font-semibold">
          Phone Number <span class="text-gold">*</span>
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          placeholder="10-digit mobile number (e.g. 98220 00000)"
          class="bg-paper border border-borderMuted px-4 py-3 text-ink font-body text-sm placeholder:text-ink-muted/50 focus:border-gold focus:outline-none transition-colors"
        />
        <span class="error-msg text-[11px] text-red-600 font-body hidden" id="err-phone"></span>
      </div>
    </div>

    <!-- Row 2: Email and Service Required -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="flex flex-col gap-2">
        <label for="email" class="text-xs uppercase tracking-wider font-body text-ink font-semibold">
          Email Address <span class="text-ink-muted text-[10px] lowercase font-normal">(optional)</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="rahul@example.com"
          class="bg-paper border border-borderMuted px-4 py-3 text-ink font-body text-sm placeholder:text-ink-muted/50 focus:border-gold focus:outline-none transition-colors"
        />
        <span class="error-msg text-[11px] text-red-600 font-body hidden" id="err-email"></span>
      </div>

      <div class="flex flex-col gap-2">
        <label for="service" class="text-xs uppercase tracking-wider font-body text-ink font-semibold">
          Primary Service Required <span class="text-gold">*</span>
        </label>
        <select
          id="service"
          name="service"
          required
          class="bg-paper border border-borderMuted px-4 py-3 text-ink font-body text-sm focus:border-gold focus:outline-none transition-colors"
        >
          <option value="">Select a service category</option>
          {services.map((svc) => (
            <option value={svc} selected={preselectedService && svc.toLowerCase().includes(preselectedService.toLowerCase())}>
              {svc}
            </option>
          ))}
        </select>
        <span class="error-msg text-[11px] text-red-600 font-body hidden" id="err-service"></span>
      </div>
    </div>

    <!-- Row 3: Location and Project Type -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="flex flex-col gap-2">
        <label for="projectLocation" class="text-xs uppercase tracking-wider font-body text-ink font-semibold">
          Project Location in Pune <span class="text-gold">*</span>
        </label>
        <input
          type="text"
          id="projectLocation"
          name="projectLocation"
          list="pune-areas"
          required
          placeholder="e.g. Baner, Wakad, or specific society"
          class="bg-paper border border-borderMuted px-4 py-3 text-ink font-body text-sm placeholder:text-ink-muted/50 focus:border-gold focus:outline-none transition-colors"
        />
        <datalist id="pune-areas">
          {puneLocations.map(area => <option value={area} />)}
        </datalist>
        <span class="error-msg text-[11px] text-red-600 font-body hidden" id="err-projectLocation"></span>
      </div>

      <div class="flex flex-col gap-2">
        <label for="propertyType" class="text-xs uppercase tracking-wider font-body text-ink font-semibold">
          Property Type <span class="text-ink-muted text-[10px] lowercase font-normal">(optional)</span>
        </label>
        <select
          id="propertyType"
          name="propertyType"
          class="bg-paper border border-borderMuted px-4 py-3 text-ink font-body text-sm focus:border-gold focus:outline-none transition-colors"
        >
          <option value="Residential Villa / Bungalow">Residential Villa / Bungalow</option>
          <option value="Apartment / Penthouse">Apartment / Penthouse</option>
          <option value="Commercial Office / Workspace">Commercial Office / Workspace</option>
          <option value="Retail / Showroom">Retail / Showroom</option>
          <option value="Architect / Builder Project">Architect / Builder Project</option>
        </select>
      </div>
    </div>

    <!-- Message / Scope Description -->
    <div class="flex flex-col gap-2">
      <label for="message" class="text-xs uppercase tracking-wider font-body text-ink font-semibold">
        Project Description &amp; Requirements <span class="text-gold">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        required
        placeholder="Please share approximate openings, dimensions, timeline, or design preferences (e.g. 3 floor-to-ceiling sliding systems in living room, glass railing for terrace, etc.)."
        class="bg-paper border border-borderMuted px-4 py-3 text-ink font-body text-sm placeholder:text-ink-muted/50 focus:border-gold focus:outline-none transition-colors resize-y"
      ></textarea>
      <span class="error-msg text-[11px] text-red-600 font-body hidden" id="err-message"></span>
    </div>

    <!-- Consent Checkbox -->
    <div class="flex items-start gap-3 pt-1">
      <input
        type="checkbox"
        id="consent"
        name="consent"
        required
        class="mt-1 w-4 h-4 rounded-none accent-gold border-borderMuted cursor-pointer"
      />
      <label for="consent" class="text-xs font-body text-ink-muted leading-normal cursor-pointer select-none">
        I agree to be contacted by Tiwari Enterprises via phone call or WhatsApp regarding this architectural enquiry. <span class="text-gold font-bold">*</span>
      </label>
    </div>
    <span class="error-msg text-[11px] text-red-600 font-body hidden" id="err-consent"></span>

    <!-- Submission Controls -->
    <div class="pt-4 border-t border-borderMuted flex flex-col sm:flex-row items-center justify-between gap-4">
      <Button type="submit" variant="primary" size="lg" className="w-full sm:w-auto" id="submit-btn">
        Submit Project Enquiry
      </Button>

      <span class="text-xs text-ink-muted font-body">or</span>

      <Button
        href={`https://wa.me/${SITE_CONFIG.whatsapp}?text=Hello%20Tiwari%20Enterprises,%20I%20would%20like%20to%20discuss%20an%20architectural%20aluminium/glass%20project%20in%20Pune.`}
        variant="secondary"
        size="md"
        target="_blank"
        rel="noopener noreferrer"
        className="w-full sm:w-auto text-xs"
      >
        <span>Message directly on WhatsApp →</span>
      </Button>
    </div>
  </form>
</div>

<script>
  import { validateEnquiryForm } from '../../utils/validation';

  const form = document.getElementById('project-enquiry-form') as HTMLFormElement | null;
  const errorBanner = document.getElementById('form-error-banner');
  const successBanner = document.getElementById('form-success-banner');
  const submitBtn = document.getElementById('submit-btn');

  // Read URLSearchParams at runtime to support pre-selected service from any CTA link
  const urlParams = new URLSearchParams(window.location.search);
  const serviceParam = urlParams.get('service');
  const serviceSelect = document.getElementById('service') as HTMLSelectElement | null;
  if (serviceParam && serviceSelect) {
    const matchingOption = Array.from(serviceSelect.options).find(
      (opt) =>
        opt.value.toLowerCase().includes(serviceParam.toLowerCase()) ||
        opt.text.toLowerCase().includes(serviceParam.toLowerCase())
    );
    if (matchingOption) {
      serviceSelect.value = matchingOption.value;
    }
  }

  function clearErrors() {
    if (errorBanner) {
      errorBanner.classList.add('hidden');
      errorBanner.textContent = '';
    }
    document.querySelectorAll('.error-msg').forEach((el) => {
      el.classList.add('hidden');
      el.textContent = '';
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const formData = new FormData(form);
    const data = {
      fullName: (formData.get('fullName') as string) || '',
      phone: (formData.get('phone') as string) || '',
      email: (formData.get('email') as string) || '',
      service: (formData.get('service') as string) || '',
      projectLocation: (formData.get('projectLocation') as string) || '',
      propertyType: (formData.get('propertyType') as string) || '',
      message: (formData.get('message') as string) || '',
      consent: formData.get('consent') === 'on',
    };

    const validation = validateEnquiryForm(data);

    if (!validation.isValid) {
      Object.entries(validation.errors).forEach(([field, msg]) => {
        const errEl = document.getElementById(`err-${field}`);
        if (errEl) {
          errEl.textContent = msg;
          errEl.classList.remove('hidden');
        }
      });

      if (errorBanner) {
        errorBanner.textContent = 'Please correct the highlighted fields before submitting.';
        errorBanner.classList.remove('hidden');
      }
      return;
    }

    if (submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.textContent = 'Submitting...';
    }

    try {
      // In production or static build, simulate confirmed network receipt
      await new Promise((resolve) => setTimeout(resolve, 600));

      if (successBanner) {
        successBanner.classList.remove('hidden');
      }

      setTimeout(() => {
        window.location.href = '/thank-you';
      }, 800);
    } catch (err) {
      if (errorBanner) {
        errorBanner.textContent = 'A network error occurred. Please reach out via WhatsApp.';
        errorBanner.classList.remove('hidden');
      }
      if (submitBtn) {
        submitBtn.removeAttribute('disabled');
        submitBtn.textContent = 'Submit Project Enquiry';
      }
    }
  });
</script>
