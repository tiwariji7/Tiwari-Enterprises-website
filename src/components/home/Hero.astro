---
import { SITE_CONFIG } from '../../utils/seo';

const heroSlides = [
  {
    image: '/images/hero/hero-sliding.webp',
    alt: 'Floor-to-ceiling thermal-break aluminium sliding systems',
    indexStr: '01',
    category: 'MINIMALIST SLIDING SYSTEMS',
    headline: 'SPACES CRAFTED TO PERFECTION.',
    description: 'Floor-to-ceiling thermal-break sliding doors engineered with flush sub-floor tracks, weather-sealed gaskets, and whisper-quiet roller bearings for contemporary architecture.',
    system: 'Architectural Aluminium Sliding System',
    tags: ['6063-T6 Architectural Alloy', '18mm Ultra-Slim Interlock', 'Multi-Point Locking', 'Flush Sub-Floor Tracks'],
    ctaText: 'Explore Sliding Systems',
    ctaLink: '/solutions/aluminium',
  },
  {
    image: '/images/hero/hero-glazing.webp',
    alt: 'High-performance architectural glass facade and curtain wall glazing',
    indexStr: '02',
    category: 'STRUCTURAL GLAZING & CURTAIN WALLS',
    headline: 'CLARITY & STRUCTURAL ELEGANCE.',
    description: 'High-performance solar-control double glazing and precision aluminium curtain walls engineered for elevated wind loads, thermal insulation, and seamless visual expanses.',
    system: 'Structural Curtain Glazing System',
    tags: ['Solar Low-E Double Glazed', 'BIS Certified Toughened Glass', '32mm Acoustic Barrier', 'Engineered Wind-Load Rating'],
    ctaText: 'Explore Glass Facades',
    ctaLink: '/solutions/glass',
  },
  {
    image: '/images/hero/hero-balustrades.webp',
    alt: 'Continuous frameless structural glass balustrades and terrace railings',
    indexStr: '03',
    category: 'FRAMELESS GLASS BALUSTRADES',
    headline: 'UNBROKEN PANORAMIC EXPANSES.',
    description: 'Continuous recessed base-shoe balustrades engineered with SentryGlas (SGP) laminated safety glass to withstand elevated wind loads while keeping expansive sightlines unbroken.',
    system: 'Heavy-Duty Glass Balustrade System',
    tags: ['17.52mm SGP Laminated Safety Glass', 'Marine Grade SS316 Slim Cap', 'Zero Vertical Posts', 'Structural Base Shoe'],
    ctaText: 'Explore Glass Railings',
    ctaLink: '/solutions/glass',
  },
  {
    image: '/images/hero/hero-partitions.webp',
    alt: 'Architectural acoustic glass partition systems and interior pivot doors',
    indexStr: '04',
    category: 'ACOUSTIC INTERIOR PARTITIONS',
    headline: 'ACOUSTIC INTEGRITY IN GLASS.',
    description: 'Demountable slimline partition walls and frameless architectural pivot doors delivering certified acoustic isolation and natural daylight for executive workspaces and residences.',
    system: 'Precision Acoustic Partition System',
    tags: ['Certified Rw 42dB Sound Attenuation', 'Concealed Hydraulic Floor Springs', 'Matte Black Anodised Frame', 'Flush Acoustic Gaskets'],
    ctaText: 'Explore Office Partitions',
    ctaLink: '/solutions/glass',
  },
];
---

<!-- Architectural Full-Bleed Hero Section (Pure Visual Canvas — Zero Slop, Zero Frosted Glass) -->
<section
  class="relative min-h-[100vh] w-full flex flex-col justify-between overflow-hidden bg-black select-none"
  id="hero-canvas"
  aria-roledescription="carousel"
  aria-label="Tiwari Enterprises Architectural Systems"
>
  <!-- Background Full-Bleed Images (Stored locally in WebP, Crisp & Architectural) -->
  <div class="absolute inset-0 z-0">
    {heroSlides.map((slide, index) => (
      <div
        class={`hero-slide-item absolute inset-0 transition-opacity duration-1000 ease-in-out ${
          index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'
        }`}
        data-slide-index={index}
      >
        <img
          src={slide.image}
          alt={slide.alt}
          class="w-full h-full object-cover object-center filter contrast-[1.08] brightness-[0.80]"
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
      </div>
    ))}

    <!-- Architectural Optical Gradients (Ensures Crisp Contrast for Text Without Milkish Haze) -->
    <div class="absolute inset-0 z-10 bg-gradient-to-t from-black/90 via-black/30 to-black/45 pointer-events-none"></div>
    <div class="absolute inset-y-0 left-0 w-full lg:w-3/4 z-10 bg-gradient-to-r from-black/80 via-black/40 to-transparent pointer-events-none"></div>
  </div>

  <!-- Main Architectural Masthead Directly on the Image (Guaranteed Safe Clearance below Fixed Nav) -->
  <div class="relative z-20 max-w-site mx-auto px-5 sm:px-8 w-full pt-28 sm:pt-32 lg:pt-36 pb-8 sm:pb-12 my-auto">
    <div class="max-w-4xl flex flex-col items-start gap-4 sm:gap-5 text-white">
      <!-- Live Category Eyebrow -->
      <div class="flex items-center gap-3">
        <span class="w-8 h-[2px] bg-gold shrink-0"></span>
        <span
          class="font-body text-xs sm:text-sm uppercase tracking-[0.25em] font-semibold text-gold transition-opacity duration-300"
          id="hero-category"
        >
          {heroSlides[0].category}
        </span>
      </div>

      <!-- Live Bold Architectural Headline -->
      <h1
        class="font-display text-3xl sm:text-5xl lg:text-6xl xl:text-7xl uppercase tracking-tight font-bold text-white leading-[0.98] drop-shadow-md transition-opacity duration-300"
        id="hero-headline"
      >
        {heroSlides[0].headline}
      </h1>

      <!-- Live Description -->
      <p
        class="font-body text-base sm:text-lg lg:text-xl text-white/90 leading-relaxed max-w-2xl font-light drop-shadow-sm transition-opacity duration-300"
        id="hero-description"
      >
        {heroSlides[0].description}
      </p>

      <!-- High-Visibility Live Technical Tags (Crisp, High Contrast, Updating on Slide Change) -->
      <div class="flex flex-wrap items-center gap-2 pt-1 pb-2 transition-opacity duration-300" id="hero-tags-container">
        {heroSlides[0].tags.map(tag => (
          <span class="hero-tag-badge px-3 py-1 bg-black/75 border border-white/30 text-white font-mono text-[11px] sm:text-xs tracking-wider uppercase font-medium">
            {tag}
          </span>
        ))}
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4 pt-1">
        <a
          href={heroSlides[0].ctaLink}
          id="hero-cta-btn"
          class="px-7 py-3.5 bg-gold hover:bg-gold-light active:bg-gold-dark text-black text-xs sm:text-sm uppercase tracking-wider font-bold transition-all duration-200 cursor-pointer shadow-md inline-flex items-center gap-2"
        >
          <span id="hero-cta-label">{heroSlides[0].ctaText}</span>
          <span>→</span>
        </a>
        <a
          href="/start-a-project"
          class="px-7 py-3.5 bg-black/40 hover:bg-white hover:text-black border border-white/60 text-white text-xs sm:text-sm uppercase tracking-wider font-semibold transition-all duration-200 cursor-pointer"
        >
          Start a Project
        </a>
        <a
          href={`https://wa.me/${SITE_CONFIG.whatsapp}?text=Hello%20Tiwari%20Enterprises,%20I%20would%20like%20to%20discuss%20an%20architectural%20aluminium%20and%20glass%20project.`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs uppercase tracking-wider text-white/80 hover:text-gold font-medium pl-2 inline-flex items-center gap-1.5 transition-colors"
        >
          <span>WhatsApp Chat →</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Architectural Metadata & Slide Tracker Bar (Solid Dark, High Contrast) -->
  <div class="relative z-20 border-t border-white/15 bg-black/90 py-4 sm:py-5">
    <div class="max-w-site mx-auto px-5 sm:px-8 flex flex-col md:flex-row md:items-center justify-between gap-4 text-white text-xs">
      <!-- Active System Name -->
      <div class="flex items-center gap-3 font-mono">
        <span class="text-gold font-bold text-sm" id="hero-slide-num">01</span>
        <span class="text-white/40">/</span>
        <span class="text-white/60">04</span>
        <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
        <span class="text-white font-semibold uppercase tracking-wider text-xs sm:text-sm transition-opacity duration-300" id="hero-system-name">
          {heroSlides[0].system}
        </span>
      </div>

      <!-- Slide Navigation Controls -->
      <div class="flex items-center justify-between sm:justify-end gap-6">
        <!-- Progress Bars -->
        <div class="flex items-center gap-2" id="hero-progress-bars">
          {heroSlides.map((_, i) => (
            <button
              class={`progress-bar-btn h-[2px] transition-all duration-300 cursor-pointer ${
                i === 0 ? 'w-10 bg-gold' : 'w-4 bg-white/30 hover:bg-white/70'
              }`}
              data-target={i}
              aria-label={`Switch to slide ${i + 1}`}
            ></button>
          ))}
        </div>

        <!-- Directional Controls -->
        <div class="flex items-center gap-2 font-mono">
          <button
            id="hero-prev-btn"
            class="px-3 py-1 border border-white/25 hover:border-gold hover:text-gold text-white text-xs transition-colors cursor-pointer"
            aria-label="Previous Slide"
          >
            PREV
          </button>
          <button
            id="hero-next-btn"
            class="px-3 py-1 border border-white/25 hover:border-gold hover:text-gold text-white text-xs transition-colors cursor-pointer"
            aria-label="Next Slide"
          >
            NEXT
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Pure Architectural Synchronization Script -->
<script define:vars={{ heroSlides }}>
  let activeIndex = 0;
  const slideItems = document.querySelectorAll('.hero-slide-item');
  const progressBars = document.querySelectorAll('.progress-bar-btn');

  // Text Elements directly on the canvas
  const categoryEl = document.getElementById('hero-category');
  const headlineEl = document.getElementById('hero-headline');
  const descriptionEl = document.getElementById('hero-description');
  const tagsContainer = document.getElementById('hero-tags-container');
  const ctaBtn = document.getElementById('hero-cta-btn');
  const ctaLabel = document.getElementById('hero-cta-label');

  // Bottom Metadata Elements
  const slideNumEl = document.getElementById('hero-slide-num');
  const systemNameEl = document.getElementById('hero-system-name');

  const prevBtn = document.getElementById('hero-prev-btn');
  const nextBtn = document.getElementById('hero-next-btn');
  const canvas = document.getElementById('hero-canvas');

  let autoSlideTimer = null;
  let textSwitchTimeout = null;

  function switchSlide(targetIndex) {
    if (targetIndex === activeIndex) return;
    if (textSwitchTimeout) clearTimeout(textSwitchTimeout);

    // Fade out previous slide
    slideItems[activeIndex]?.classList.remove('opacity-100', 'z-10');
    slideItems[activeIndex]?.classList.add('opacity-0', 'z-0');
    progressBars[activeIndex]?.classList.remove('w-10', 'bg-gold');
    progressBars[activeIndex]?.classList.add('w-4', 'bg-white/30');

    // Subtle fade out text and tags
    if (headlineEl) headlineEl.style.opacity = '0.25';
    if (descriptionEl) descriptionEl.style.opacity = '0.25';
    if (categoryEl) categoryEl.style.opacity = '0.25';
    if (tagsContainer) tagsContainer.style.opacity = '0.25';
    if (systemNameEl) systemNameEl.style.opacity = '0.25';

    activeIndex = (targetIndex + heroSlides.length) % heroSlides.length;
    const current = heroSlides[activeIndex];

    // Fade in new slide
    slideItems[activeIndex]?.classList.remove('opacity-0', 'z-0');
    slideItems[activeIndex]?.classList.add('opacity-100', 'z-10');
    progressBars[activeIndex]?.classList.remove('w-4', 'bg-white/30');
    progressBars[activeIndex]?.classList.add('w-10', 'bg-gold');

    // Update text and tag content smoothly
    setTimeout(() => {
      if (categoryEl) {
        categoryEl.textContent = current.category;
        categoryEl.style.opacity = '1';
      }
      if (headlineEl) {
        headlineEl.textContent = current.headline;
        headlineEl.style.opacity = '1';
      }
      if (descriptionEl) {
        descriptionEl.textContent = current.description;
        descriptionEl.style.opacity = '1';
      }
      if (tagsContainer && current.tags) {
        tagsContainer.innerHTML = current.tags
          .map(
            (tag) =>
              `<span class="hero-tag-badge px-3 py-1 bg-black/75 border border-white/30 text-white font-mono text-[11px] sm:text-xs tracking-wider uppercase font-medium transition-opacity duration-200">${tag}</span>`
          )
          .join('');
        tagsContainer.style.opacity = '1';
      }
      if (ctaBtn) ctaBtn.setAttribute('href', current.ctaLink);
      if (ctaLabel) ctaLabel.textContent = current.ctaText;

      if (slideNumEl) slideNumEl.textContent = current.indexStr;
      if (systemNameEl) {
        systemNameEl.textContent = current.system;
        systemNameEl.style.opacity = '1';
      }
    }, 180);
  }

  function advance() {
    switchSlide(activeIndex + 1);
  }

  function retreat() {
    switchSlide(activeIndex - 1);
  }

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function startTimer() {
    stopTimer();
    if (prefersReducedMotion) return;
    autoSlideTimer = setInterval(advance, 5500);
  }

  function stopTimer() {
    if (autoSlideTimer) {
      clearInterval(autoSlideTimer);
      autoSlideTimer = null;
    }
  }

  nextBtn?.addEventListener('click', () => {
    advance();
    startTimer();
  });

  prevBtn?.addEventListener('click', () => {
    retreat();
    startTimer();
  });

  progressBars.forEach((bar) => {
    bar.addEventListener('click', () => {
      const idx = parseInt(bar.getAttribute('data-target') || '0', 10);
      switchSlide(idx);
      startTimer();
    });
  });

  canvas?.addEventListener('mouseenter', stopTimer);
  canvas?.addEventListener('mouseleave', startTimer);
  canvas?.addEventListener('focusin', stopTimer);
  canvas?.addEventListener('focusout', (e: FocusEvent) => {
    if (!canvas.contains(e.relatedTarget as Node | null)) startTimer();
  });

  startTimer();
</script>
