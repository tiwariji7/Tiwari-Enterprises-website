---
import { SITE_CONFIG } from '../../utils/seo';

const heroSlides = [
  {
    id: 'sliding-systems',
    image: '/images/hero/hero-sliding.webp',
    alt: 'Luxury contemporary villa with expansive glass panels and slim black aluminium sliding frames',
    indexStr: '01',
    category: 'PREMIUM ALUMINIUM SLIDING SYSTEMS',
    headline: 'Spaces Crafted to Perfection.',
    description: 'Premium aluminium sliding doors and windows designed for seamless transitions, refined aesthetics and everyday functionality.',
    tags: ['SLIMLINE PROFILES', 'PRECISION ENGINEERING', 'SMOOTH OPERATION'],
    primaryCta: { label: 'Explore Aluminium Systems →', href: '/solutions/aluminium' },
    secondaryCta: { label: 'Start a Project', href: '/start-a-project' },
    whatsappMsg: 'Hello Tiwari Enterprises, I would like to inquire about premium aluminium sliding systems in Pune.',
  },
  {
    id: 'structural-glazing',
    image: '/images/hero/hero-glazing.webp',
    alt: 'Expansive contemporary architectural glass facade and structural aluminium curtain walls',
    indexStr: '02',
    category: 'STRUCTURAL GLAZING & CURTAIN WALLS',
    headline: 'Architecture Defined by Glass.',
    description: 'Contemporary glazing solutions that combine clean architectural lines, natural light and precision aluminium framing.',
    tags: ['GLASS FACADES', 'ALUMINIUM FRAMING', 'MODERN ARCHITECTURE'],
    primaryCta: { label: 'Explore Glass Facades →', href: '/solutions/glass' },
    secondaryCta: { label: 'Start a Project', href: '/start-a-project' },
    whatsappMsg: 'Hello Tiwari Enterprises, I would like to inquire about structural glazing and curtain walls in Pune.',
  },
  {
    id: 'frameless-railings',
    image: '/images/hero/hero-balustrades.webp',
    alt: 'Contemporary luxury residence with continuous frameless glass balcony railings and panoramic views',
    indexStr: '03',
    category: 'FRAMELESS GLASS RAILINGS',
    headline: 'An Uninterrupted View of Luxury.',
    description: 'Minimal glass railing solutions that bring openness, elegance and a seamless visual connection to modern architecture.',
    tags: ['MINIMAL FRAME DESIGN', 'SAFETY GLASS OPTIONS', 'CUSTOM INSTALLATION'],
    primaryCta: { label: 'Explore Glass Railings →', href: '/solutions/glass' },
    secondaryCta: { label: 'Start a Project', href: '/start-a-project' },
    whatsappMsg: 'Hello Tiwari Enterprises, I would like to inquire about frameless glass railings in Pune.',
  },
  {
    id: 'acoustic-partitions',
    image: '/images/hero/hero-partitions.webp',
    alt: 'Sophisticated modern office with slim aluminium-framed glass partitions and natural daylight',
    indexStr: '04',
    category: 'ACOUSTIC GLASS PARTITIONS',
    headline: 'Privacy. Without Compromising Light.',
    description: 'Elegant glass partition systems designed to define spaces while maintaining openness, natural light and a refined architectural finish.',
    tags: ['SLIMLINE FRAMES', 'MODERN OFFICE SPACES', 'ACOUSTIC OPTIONS'],
    primaryCta: { label: 'Explore Office Partitions →', href: '/solutions/glass' },
    secondaryCta: { label: 'Start a Project', href: '/start-a-project' },
    whatsappMsg: 'Hello Tiwari Enterprises, I would like to inquire about acoustic glass partitions in Pune.',
  },
];
---

<!-- Architectural Full-Bleed Hero Canvas (WCAG 2.2 AA Compliant, Cinematic Slider) -->
<section
  class="relative min-h-[100vh] w-full flex flex-col justify-between overflow-hidden bg-charcoal select-none"
  id="hero-canvas"
  role="region"
  aria-roledescription="carousel"
  aria-label="Tiwari Enterprises Architectural Showcase"
>
  <!-- Screen Reader Live Announcer for Manual Navigation Only -->
  <div class="sr-only" aria-live="polite" aria-atomic="true" id="hero-sr-announcer">
    Slide 1 of 4: Spaces Crafted to Perfection. Premium aluminium sliding systems.
  </div>

  <!-- Background Image Carousel Stack (WebP, Hardware-Accelerated, Zero CLS) -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    {heroSlides.map((slide, index) => (
      <div
        class={`hero-slide-item absolute inset-0 transition-opacity duration-800 ease-in-out ${
          index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'
        }`}
        data-slide-index={index}
        aria-hidden={index === 0 ? 'false' : 'true'}
      >
        <img
          src={slide.image}
          alt={slide.alt}
          class={`hero-slide-img w-full h-full object-cover object-center filter contrast-[1.04] brightness-[0.96] transition-transform duration-[7500ms] ease-out will-change-transform ${
            index === 0 ? 'scale-105' : 'scale-100'
          }`}
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
          decoding="async"
        />
      </div>
    ))}

    <!-- Photographic Clarity Scrims: Keep Background Radiant While Making Left-Aligned Text 100% Readable -->
    <!-- Top Nav Shadow -->
    <div class="absolute top-0 inset-x-0 h-36 bg-gradient-to-b from-[#0B0F15]/90 via-[#0B0F15]/40 to-transparent pointer-events-none z-10"></div>
    <!-- Left Masthead Directional Scrim (Text Reading Zone) -->
    <div class="absolute inset-y-0 left-0 w-full sm:w-[85%] md:w-[72%] lg:w-[58%] bg-gradient-to-r from-[#0B0F15]/95 via-[#0B0F15]/75 to-transparent pointer-events-none z-10"></div>
    <!-- Bottom Controller Fade -->
    <div class="absolute bottom-0 inset-x-0 h-28 bg-gradient-to-t from-[#0B0F15]/90 via-[#0B0F15]/30 to-transparent pointer-events-none z-10"></div>
  </div>

  <!-- Main Architectural Masthead (Generous 112px+ Navbar Clearance) -->
  <div class="relative z-20 max-w-site mx-auto px-5 sm:px-8 w-full pt-28 sm:pt-32 lg:pt-36 pb-8 sm:pb-12 my-auto">
    <div class="max-w-4xl flex flex-col items-start gap-4 sm:gap-5" id="hero-text-block">
      
      <!-- Permanent Semantic H1: Stable, Singular, Architecturally Integrated -->
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-[#ECC880] shadow-[0_0_8px_rgba(236,200,128,0.7)] shrink-0" aria-hidden="true"></span>
        <h1 class="font-mono text-[11px] sm:text-xs uppercase tracking-[0.24em] text-white font-semibold drop-shadow-[0_2px_4px_rgba(0,0,0,0.95)]">
          Premium Aluminium &amp; Glass Solutions in Pune
        </h1>
      </div>

      <!-- Live Category Eyebrow -->
      <div class="flex items-center gap-3">
        <span class="w-8 h-[2px] bg-[#ECC880] shadow-[0_0_6px_rgba(236,200,128,0.6)] shrink-0" aria-hidden="true"></span>
        <span
          class="font-body text-xs sm:text-sm uppercase tracking-[0.22em] font-bold text-[#ECC880] drop-shadow-[0_2px_4px_rgba(0,0,0,0.95)] transition-opacity duration-300"
          id="hero-category"
        >
          {heroSlides[0].category}
        </span>
      </div>

      <!-- Live Slide Heading (Semantically H2 for All Slides per SEO Spec) -->
      <h2
        class="font-display text-4xl sm:text-6xl lg:text-7xl xl:text-8xl uppercase tracking-tight font-bold text-white leading-[0.98] drop-shadow-[0_4px_16px_rgba(0,0,0,0.95)] transition-all duration-300"
        id="hero-headline"
      >
        {heroSlides[0].headline}
      </h2>

      <!-- Live Description -->
      <p
        class="font-body text-base sm:text-lg lg:text-xl text-white font-normal leading-relaxed max-w-2xl drop-shadow-[0_2px_6px_rgba(0,0,0,0.95)] transition-opacity duration-300"
        id="hero-description"
      >
        {heroSlides[0].description}
      </p>

      <!-- Semantic List of Technical Specification Tags (High-Contrast Architectural Badges) -->
      <ul
        class="flex flex-wrap items-center gap-2 pt-1 pb-1 transition-opacity duration-300"
        id="hero-tags-list"
        aria-label="System key specifications"
      >
        {heroSlides[0].tags.map((tag) => (
          <li class="px-3.5 py-1.5 bg-[#0B0F15]/90 backdrop-blur-md border border-[#ECC880]/60 text-white font-mono text-[11px] sm:text-xs tracking-wider uppercase font-semibold shadow-[0_4px_14px_rgba(0,0,0,0.8)] inline-flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#ECC880] shrink-0" aria-hidden="true"></span>
            {tag}
          </li>
        ))}
      </ul>

      <!-- Action Buttons (High Contrast, Accessible Focus States) -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href={heroSlides[0].primaryCta.href}
          id="hero-primary-cta"
          class="px-7 py-3.5 bg-[#ECC880] hover:bg-[#F3D79A] text-[#0B0F15] text-xs sm:text-sm uppercase tracking-wider font-bold transition-all duration-200 cursor-pointer shadow-[0_6px_22px_rgba(0,0,0,0.6)] inline-flex items-center gap-2 focus-visible:outline-2 focus-visible:outline-white"
        >
          <span id="hero-cta-label">{heroSlides[0].primaryCta.label}</span>
        </a>
        
        <a
          href={heroSlides[0].secondaryCta.href}
          class="px-7 py-3.5 bg-[#151B24]/95 hover:bg-[#202C39] border-2 border-white/85 hover:border-[#ECC880] text-white hover:text-[#ECC880] text-xs sm:text-sm uppercase tracking-wider font-bold backdrop-blur-md transition-all duration-200 cursor-pointer shadow-[0_6px_22px_rgba(0,0,0,0.6)] inline-flex items-center justify-center focus-visible:outline-2 focus-visible:outline-[#ECC880]"
        >
          <span>{heroSlides[0].secondaryCta.label}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Architectural Metadata & Slider Controller Bar -->
  <div class="relative z-20 border-t border-white/20 bg-[#0B0F15]/95 py-4 sm:py-5 backdrop-blur-md">
    <div class="max-w-site mx-auto px-5 sm:px-8 flex flex-col md:flex-row md:items-center justify-between gap-4 text-white text-xs">
      
      <!-- Slide Counter and System Discipline Identifier -->
      <div class="flex items-center gap-3 font-mono">
        <span class="text-[#ECC880] font-bold text-sm tracking-wider" id="hero-slide-num">01</span>
        <span class="text-white/40">/</span>
        <span class="text-white/60">04</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#ECC880] shadow-[0_0_6px_rgba(236,200,128,0.6)] shrink-0" aria-hidden="true"></span>
        <span class="text-white font-semibold uppercase tracking-wider text-xs sm:text-sm drop-shadow-[0_1px_3px_rgba(0,0,0,0.8)] transition-opacity duration-300" id="hero-system-name">
          {heroSlides[0].category}
        </span>
      </div>

      <!-- Controls: Progress Bars, Play/Pause Toggle, Previous/Next Navigation -->
      <div class="flex items-center justify-between sm:justify-end gap-5">
        
        <!-- 4 Individual Progress Indicators -->
        <div class="flex items-center gap-2" role="tablist" aria-label="Slide selectors">
          {heroSlides.map((slide, i) => (
            <button
              class={`progress-bar-btn relative h-1.5 rounded-full overflow-hidden transition-all duration-300 cursor-pointer focus-visible:outline-2 focus-visible:outline-[#ECC880] ${
                i === 0 ? 'w-10 bg-[#ECC880] shadow-[0_0_10px_rgba(236,200,128,0.7)]' : 'w-4 bg-white/35 hover:bg-white/70'
              }`}
              data-target={i}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`Go to slide ${i + 1}: ${slide.headline}`}
            >
              <span class="sr-only">Slide {i + 1}</span>
            </button>
          ))}
        </div>

        <!-- Play / Pause Controller Button -->
        <button
          id="hero-play-pause-btn"
          class="p-1.5 border border-white/20 hover:border-metallicGold hover:text-metallicGold text-white/80 transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-metallicGold flex items-center justify-center"
          aria-label="Pause slideshow"
          title="Pause slideshow"
        >
          <!-- Pause Icon (Default when autoplaying) -->
          <svg id="hero-pause-icon" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
          </svg>
          <!-- Play Icon (Hidden when playing) -->
          <svg id="hero-play-icon" class="w-3.5 h-3.5 fill-current hidden" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </button>

        <!-- Directional Navigation Buttons -->
        <div class="flex items-center gap-2 font-mono" role="group" aria-label="Slider navigation">
          <button
            id="hero-prev-btn"
            class="px-3 py-1 border border-white/25 hover:border-metallicGold hover:text-metallicGold text-white text-xs transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-metallicGold"
            aria-label="Previous slide"
          >
            PREV
          </button>
          <button
            id="hero-next-btn"
            class="px-3 py-1 border border-white/25 hover:border-metallicGold hover:text-metallicGold text-white text-xs transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-metallicGold"
            aria-label="Next slide"
          >
            NEXT
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Production-Grade Architectural Slider Script -->
<script define:vars={{ heroSlides }}>
  const AUTOPLAY_INTERVAL = 7000;
  const TRANSITION_DURATION = 800;

  let activeIndex = 0;
  let isPlaying = true;
  let isTransitioning = false;
  let autoSlideTimer = null;
  let textTimeout = null;

  const canvas = document.getElementById('hero-canvas');
  const slideItems = document.querySelectorAll('.hero-slide-item');
  const progressBars = document.querySelectorAll('.progress-bar-btn');
  const announcer = document.getElementById('hero-sr-announcer');

  // Text Elements
  const textBlock = document.getElementById('hero-text-block');
  const categoryEl = document.getElementById('hero-category');
  const headlineEl = document.getElementById('hero-headline');
  const descriptionEl = document.getElementById('hero-description');
  const tagsList = document.getElementById('hero-tags-list');
  const primaryCta = document.getElementById('hero-primary-cta');
  const ctaLabel = document.getElementById('hero-cta-label');

  // Bottom Metadata
  const slideNumEl = document.getElementById('hero-slide-num');
  const systemNameEl = document.getElementById('hero-system-name');

  // Control Buttons
  const prevBtn = document.getElementById('hero-prev-btn');
  const nextBtn = document.getElementById('hero-next-btn');
  const playPauseBtn = document.getElementById('hero-play-pause-btn');
  const playIcon = document.getElementById('hero-play-icon');
  const pauseIcon = document.getElementById('hero-pause-icon');

  // Reduced Motion Preference
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReducedMotion) {
    isPlaying = false;
  }

  function updatePlayPauseUI() {
    if (!playPauseBtn || !playIcon || !pauseIcon) return;
    if (isPlaying) {
      playIcon.classList.add('hidden');
      pauseIcon.classList.remove('hidden');
      playPauseBtn.setAttribute('aria-label', 'Pause slideshow');
      playPauseBtn.setAttribute('title', 'Pause slideshow');
    } else {
      pauseIcon.classList.add('hidden');
      playIcon.classList.remove('hidden');
      playPauseBtn.setAttribute('aria-label', 'Play slideshow');
      playPauseBtn.setAttribute('title', 'Play slideshow');
    }
  }

  function announceSlide(index) {
    if (!announcer) return;
    const slide = heroSlides[index];
    announcer.textContent = `Slide ${index + 1} of ${heroSlides.length}: ${slide.headline}. ${slide.category}.`;
  }

  function switchSlide(targetIndex, isManual = false) {
    if (targetIndex === activeIndex || isTransitioning) return;
    isTransitioning = true;

    if (textTimeout) {
      clearTimeout(textTimeout);
      textTimeout = null;
    }

    const prevIndex = activeIndex;
    activeIndex = (targetIndex + heroSlides.length) % heroSlides.length;
    const current = heroSlides[activeIndex];

    // Fade out previous slide image & reset zoom
    const prevSlideEl = slideItems[prevIndex];
    if (prevSlideEl) {
      prevSlideEl.classList.remove('opacity-100', 'z-10');
      prevSlideEl.classList.add('opacity-0', 'z-0');
      prevSlideEl.setAttribute('aria-hidden', 'true');
      const prevImg = prevSlideEl.querySelector('.hero-slide-img');
      if (prevImg) prevImg.classList.remove('scale-105');
      if (prevImg) prevImg.classList.add('scale-100');
    }

    // Update progress bars
    progressBars.forEach((bar, i) => {
      if (i === activeIndex) {
        bar.classList.remove('w-4', 'bg-white/35');
        bar.classList.add('w-10', 'bg-[#ECC880]', 'shadow-[0_0_10px_rgba(236,200,128,0.7)]');
        bar.setAttribute('aria-selected', 'true');
      } else {
        bar.classList.remove('w-10', 'bg-[#ECC880]', 'shadow-[0_0_10px_rgba(236,200,128,0.7)]');
        bar.classList.add('w-4', 'bg-white/35');
        bar.setAttribute('aria-selected', 'false');
      }
    });

    // Fade in target slide image & start subtle zoom
    const nextSlideEl = slideItems[activeIndex];
    if (nextSlideEl) {
      nextSlideEl.classList.remove('opacity-0', 'z-0');
      nextSlideEl.classList.add('opacity-100', 'z-10');
      nextSlideEl.setAttribute('aria-hidden', 'false');
      const nextImg = nextSlideEl.querySelector('.hero-slide-img');
      if (nextImg && !prefersReducedMotion) {
        nextImg.classList.remove('scale-100');
        nextImg.classList.add('scale-105');
      }
    }

    // Subtle fade out text block
    if (textBlock && !prefersReducedMotion) {
      textBlock.style.opacity = '0.2';
      textBlock.style.transform = 'translateY(6px)';
    }

    // Update text content with architectural precision
    textTimeout = setTimeout(() => {
      if (categoryEl) categoryEl.textContent = current.category;
      if (headlineEl) headlineEl.textContent = current.headline;
      if (descriptionEl) descriptionEl.textContent = current.description;

      if (tagsList && current.tags) {
        tagsList.innerHTML = current.tags
          .map(
            (tag) =>
              `<li class="px-3.5 py-1.5 bg-[#0B0F15]/90 backdrop-blur-md border border-[#ECC880]/60 text-white font-mono text-[11px] sm:text-xs tracking-wider uppercase font-semibold shadow-[0_4px_14px_rgba(0,0,0,0.8)] inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#ECC880] shrink-0" aria-hidden="true"></span>${tag}</li>`
          )
          .join('');
      }

      if (primaryCta) primaryCta.setAttribute('href', current.primaryCta.href);
      if (ctaLabel) ctaLabel.textContent = current.primaryCta.label;

      if (slideNumEl) slideNumEl.textContent = current.indexStr;
      if (systemNameEl) systemNameEl.textContent = current.category;

      if (textBlock) {
        textBlock.style.opacity = '1';
        textBlock.style.transform = 'translateY(0)';
      }

      if (isManual) {
        announceSlide(activeIndex);
      }
    }, 200);

    // Release transition lock after crossfade completes
    setTimeout(() => {
      isTransitioning = false;
    }, TRANSITION_DURATION);
  }

  function advance(isManual = false) {
    switchSlide(activeIndex + 1, isManual);
  }

  function retreat(isManual = false) {
    switchSlide(activeIndex - 1, isManual);
  }

  function startTimer() {
    stopTimer();
    if (!isPlaying || prefersReducedMotion) return;
    autoSlideTimer = setInterval(() => advance(false), AUTOPLAY_INTERVAL);
  }

  function stopTimer() {
    if (autoSlideTimer) {
      clearInterval(autoSlideTimer);
      autoSlideTimer = null;
    }
  }

  function pauseAutoplay() {
    isPlaying = false;
    stopTimer();
    updatePlayPauseUI();
  }

  function resumeAutoplay() {
    if (prefersReducedMotion) return;
    isPlaying = true;
    startTimer();
    updatePlayPauseUI();
  }

  function togglePlayPause() {
    if (isPlaying) {
      pauseAutoplay();
    } else {
      resumeAutoplay();
    }
  }

  // Event Listeners: Navigation
  nextBtn?.addEventListener('click', () => {
    advance(true);
    startTimer();
  });

  prevBtn?.addEventListener('click', () => {
    retreat(true);
    startTimer();
  });

  playPauseBtn?.addEventListener('click', togglePlayPause);

  progressBars.forEach((bar) => {
    bar.addEventListener('click', () => {
      const idx = parseInt(bar.getAttribute('data-target') || '0', 10);
      switchSlide(idx, true);
      startTimer();
    });
  });

  // Mouse Hover Pausing
  canvas?.addEventListener('mouseenter', () => {
    stopTimer();
  });

  canvas?.addEventListener('mouseleave', () => {
    if (isPlaying) startTimer();
  });

  // Focus Handling for WCAG 2.2 AA
  canvas?.addEventListener('focusin', () => {
    stopTimer();
  });

  canvas?.addEventListener('focusout', (e) => {
    if (!canvas.contains(e.relatedTarget) && isPlaying) {
      startTimer();
    }
  });

  // Keyboard Navigation: Left / Right Arrows
  canvas?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') {
      advance(true);
      startTimer();
    } else if (e.key === 'ArrowLeft') {
      retreat(true);
      startTimer();
    }
  });

  // Mobile Touch Swipe Navigation
  let touchStartX = 0;
  let touchEndX = 0;
  const SWIPE_THRESHOLD = 45;

  canvas?.addEventListener(
    'touchstart',
    (e) => {
      touchStartX = e.changedTouches[0].screenX;
    },
    { passive: true }
  );

  canvas?.addEventListener(
    'touchend',
    (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > SWIPE_THRESHOLD) {
        if (diff > 0) {
          advance(true);
        } else {
          retreat(true);
        }
        startTimer();
      }
    },
    { passive: true }
  );

  // Initialize
  updatePlayPauseUI();
  if (!prefersReducedMotion) {
    startTimer();
  }
</script>
